# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Configuration
# Found in your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Secret Service Role Key (Recommended for backend server API operations to bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Public Anon Key (Optional / Fallback)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# JWT Authentication Configuration
JWT_SECRET=super_secret_jwt_key_task_manager_2026_secure
JWT_EXPIRE=7d
